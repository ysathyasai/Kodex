@@ -0,0 +1,15 @@
+import pytest
+from src.services.payment_gateway_config import PaymentGatewayConfigService
+
+def test_default_timeout_fallback():
+    service = PaymentGatewayConfigService({})
+    assert service.get_api_timeout_seconds() == 30
+
+def test_custom_timeout_resolution():
+    service = PaymentGatewayConfigService({"api_timeout_seconds": 60})
+    assert service.get_api_timeout_seconds() == 60
