+-- Migration: 001_payment_gateway_config.sql
+-- Purpose: Store dynamic tenant payment gateway configurations
+CREATE TABLE IF NOT EXISTS payment_gateway_configs (
+    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
+    tenant_id VARCHAR(64) NOT NULL,
+    api_timeout_seconds INT DEFAULT 30,
+    max_retries INT DEFAULT 3,
+    endpoint_url TEXT NOT NULL,
+    created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP
+);
+CREATE INDEX idx_pay_tenant ON payment_gateway_configs(tenant_id);
diff --git a/src/api/payment_routes.py b/src/api/payment_routes.py
new file mode 100644
index 0000000..cb1542a
--- /dev/null
+++ b/src/api/payment_routes.py
@@ -0,0 +1,14 @@
+from flask import Blueprint, jsonify, request
+from src.services.payment_gateway_config import PaymentGatewayConfigService
+
+payments_bp = Blueprint("payments", __name__)
+
+@payments_bp.route("/api/v1/payments/config", methods=["GET"])
+def get_gateway_config():
+    tenant_config = request.headers.get("X-Tenant-Config", {})
+    service = PaymentGatewayConfigService(tenant_config)
+    return jsonify({
+        "timeout": service.get_api_timeout_seconds(),
+        "retries": service.get_max_retry_attempts()
+    })
