# ==============================================================================
# Kodex AI Code Review Agent - Environment Configuration
# ==============================================================================

# Flask Server Port & Host
PORT=5000
HOST=0.0.0.0
DEBUG=false

# ------------------------------------------------------------------------------
# Groq API Configuration
# Get your free API key at: https://groq.com/
# ------------------------------------------------------------------------------
GROQ_API_KEY=your_groq_api_key_here

# Groq Model (Recommended for HackwithHyderabad: qwen/qwen3-32b or openai/gpt-oss-120b)
GROQ_MODEL=qwen/qwen3-32b
GROQ_FALLBACK_MODEL=llama-3.3-70b-versatile
GROQ_TEMPERATURE=0.2
GROQ_MAX_TOKENS=2048

# ------------------------------------------------------------------------------
# Vectorize Hindsight API Configuration
# Documentation: https://hindsight.vectorize.io/
# Cloud Dashboard: https://ui.hindsight.vectorize.io
# ------------------------------------------------------------------------------
# Local Docker instance: http://localhost:8888 (or http://hindsight:8888 inside docker compose)
# Hindsight Cloud: https://api.hindsight.vectorize.io
HINDSIGHT_BASE_URL=http://localhost:8888
HINDSIGHT_API_KEY=

# Hindsight Memory Bank namespace for codebase conventions
HINDSIGHT_BANK_ID=repo-standards
HINDSIGHT_TIMEOUT=10.0

# Allow high-fidelity simulation fallback when running without external API keys
ALLOW_MOCK_FALLBACK=true
